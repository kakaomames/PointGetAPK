<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌍 Open Poikatsu (99%還元)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="現在の獲得残高"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="0.00 円"
        android:textColor="#000000"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- 放置ゲーム要素のエネルギー表示 -->
    <TextView
        android:id="@+id/textEnergy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="溜まったエネルギー: 0 ⚡"
        android:textSize="16sp"
        android:textColor="#FF8C00"
        android:layout_marginBottom="16sp" />

    <Button
        android:id="@+id/btnCollectEnergy"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="16dp"
        android:text="⚡ 放置エネルギーを回収する"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnWatchVideoAd"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:text="🎬 動画広告を見て 99% 還元ゲット"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnHighRewardAd"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="🔥 高額オファー達成 (99%還元)"
        android:textSize="16sp" />

</LinearLayout>
